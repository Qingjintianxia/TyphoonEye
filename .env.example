# 服务端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# JWT 签名密钥（生产环境必填，缺失则拒绝启动）
# 建议：openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# JWT 有效期（见 jsonwebtoken 的 expiresIn 语法）
JWT_EXPIRES_IN=7d

# 允许跨域的前端来源，逗号分隔（对应前端 dev server 地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 登录限流：窗口毫秒数 / 窗口内最大次数
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=10

# 注册限流：窗口毫秒数 / 窗口内最大次数
REGISTER_LIMIT_WINDOW_MS=3600000
REGISTER_LIMIT_MAX=20

# 国内合规底图（天地图）浏览器端密钥：申请地址 https://www.tianditu.gov.cn/
# 未配置时前端降级为「示意海图」占位，不会回退到任何境外底图
# 说明：这是浏览器端 key，会随构建产物下发，天地图按「key + 调用域名」做配额校验；
#       真正需要保密的是上面的 JWT_SECRET，两者不要混为一谈。
# 修改后必须重启 dev server —— import.meta.env 在启动/构建期注入，热更新不会重读。
VITE_TIANDITU_KEY=
